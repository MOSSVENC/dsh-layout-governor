{
  "name": "dsh-layout-governor",
  "version": "0.1.0",
  "description": "Audits a workspace directory tree against a policy file: duplicate payloads, misplaced backups, unregistered large files, README-vs-disk drift and version families. Read-only by design: it reports and prints a fix plan instead of touching files.",
  "icon": "icon.svg",
  "author": "MOSSVENC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MOSSVENC/dsh-layout-governor.git"
  },
  "homepage": "https://github.com/MOSSVENC/dsh-layout-governor",
  "bugs": {
    "url": "https://github.com/MOSSVENC/dsh-layout-governor/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 || >=0.2.1-rc.2 || >=0.2.2-rc.1"
  },
  "main": "lib/index.js",
  "bin": {
    "layout-governor": "./bin/layout-governor.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./engine": "./lib/engine/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/engine/**/*.js",
    "bin/*.mjs",
    "cordis.patch.yml",
    "layout.policy.yml",
    "layout.registry.yml",
    "docs/*.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/",
    "audit": "node bin/layout-governor.mjs --root ../../.. --concurrency 16",
    "audit:check": "node bin/layout-governor.mjs --root ../../.. --concurrency 16 --check",
    "audit:off": "node bin/layout-governor.mjs --root ../../.. --all-off"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2+": "compatible",
        "0.2.1-rc.2+": "compatible",
        "0.2.2-rc.1+": "compatible"
      }
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "layout",
    "governance",
    "audit",
    "duplicates"
  ],
  "license": "MIT"
}
